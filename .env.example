# Copy to .env and adjust as needed. Nothing here is a real secret.

ENVIRONMENT=local
DEBUG=true
LOG_FORMAT=console

DATABASE_URL=postgresql+asyncpg://envforge:envforge@postgres:5432/envforge
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET_KEY=dev-only-change-me
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=dev-only-change-me
GITHUB_API_TOKEN=

CORS_ORIGINS=["http://localhost:5173"]

KUBE_CONTEXT=kind-envforge
TERRAFORM_WORKSPACE_ROOT=/tmp/envforge/terraform-workspaces
